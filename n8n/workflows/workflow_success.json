{
  "name": "Aadhaar Verification — Success",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aadhaar-success",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [{"value1": "={{$json[\"status\"]}}", "operation": "equals", "value2": "COMPLETED"}]
        }
      },
      "name": "Filter Completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "functionCode": "const item = $input.item.json;\nreturn [{\n  json: {\n    subject: `Aadhaar Verification Completed — ${item.reference_id}`,\n    body: `Name: ${item.name || 'N/A'}\\nUID: ${item.masked_aadhaar || 'N/A'}\\nRisk: ${item.risk_score || 'N/A'}\\nQR Valid: ${item.qr_valid}`,\n    request_id: item.request_id,\n    risk_score: item.risk_score,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "name": "Format Notification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [750, 200]
    }
  ],
  "connections": {
    "Webhook": {"main": [[{"node": "Filter Completed", "type": "main", "index": 0}]]},
    "Filter Completed": {"main": [[{"node": "Format Notification", "type": "main", "index": 0}], []]}
  },
  "active": true,
  "settings": {}
}
