# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aadhaar_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=4

# Storage (MinIO/S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=aadhaar-platform

# Security
UIDAI_PUBLIC_KEY_PATH=certs/uidai_auth.pem
ENCRYPTION_KEY=replace-with-32-byte-hex-key
JWT_SECRET=replace-with-secure-secret

# API Settings
RATE_LIMIT_PER_MINUTE=100
MAX_BULK_UPLOAD_MB=500
WEBHOOK_RETRY_COUNT=3

# Features
LIVENESS_ENABLED=false

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=
