{
  "name": "Aadhaar Verification Platform",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/redis:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/postgres:1": { "version": "15" }
  },

  "forwardPorts": [8000, 3000],

  "portsAttributes": {
    "8000": {
      "label": "API",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "3000": {
      "label": "Dashboard",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },

  "postCreateCommand": "bash .devcontainer/install.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "rangav.vscode-thunder-client"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "onCreateCommand": "echo '✅ Codespace created. Run: bash start.sh' > /tmp/welcome.txt"
}
