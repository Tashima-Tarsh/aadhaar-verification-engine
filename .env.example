# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/aadhaar_platform

# ── Redis & Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=4

# ── Storage (MinIO / S3) ──────────────────────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=aadhaar-platform

# ── Security ──────────────────────────────────────────────────────────────────
# Path to UIDAI RSA public key PEM (offline verification only)
UIDAI_PUBLIC_KEY_PATH=certs/uidai_auth.pem

# 32-byte hex key for Fernet symmetric encryption (document passwords)
ENCRYPTION_KEY=replace-with-32-byte-hex-key

# JWT secrets
JWT_SECRET=replace-with-at-least-32-char-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Settings ──────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
APP_VERSION=1.0.0
RATE_LIMIT_PER_MINUTE=100
MAX_BULK_UPLOAD_MB=500
MAX_BULK_FILES=500
WEBHOOK_RETRY_COUNT=3

# ── Features ──────────────────────────────────────────────────────────────────
# Set to true and install deepface extra to enable face liveness detection
LIVENESS_ENABLED=false

# ── Logging / Monitoring ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Leave empty to disable Sentry
SENTRY_DSN=
